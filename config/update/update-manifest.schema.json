{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elderred.invalid/nougat/update-manifest-v1.schema.json",
  "title": "Nougat Media Suite Signed Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "application_id",
    "channel",
    "version",
    "published_at",
    "packages",
    "signature"
  ],
  "properties": {
    "format": {"const": "NOUGAT_SIGNED_UPDATE_MANIFEST"},
    "format_version": {"const": 1},
    "application_id": {"const": "nougat-media-suite"},
    "channel": {"type": "string", "enum": ["stable", "beta", "development"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "published_at": {"type": "string", "format": "date-time"},
    "minimum_supported_version": {"type": "string"},
    "release_notes": {"type": "string"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "filename", "size", "sha256", "sources"],
        "properties": {
          "platform": {"type": "string"},
          "architecture": {"type": "string"},
          "filename": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "url"],
              "properties": {
                "transport": {"type": "string", "enum": ["github-release", "https", "onion", "mirror"]},
                "url": {"type": "string", "minLength": 1},
                "priority": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "sha256", "size", "sources"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "size": {"type": "integer", "minimum": 1},
          "sources": {"type": "array", "minItems": 1}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
